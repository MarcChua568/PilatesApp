PORT=3000

# Local Homebrew PostgreSQL (no Docker on this machine).
# Both databases live on the same running instance; the test DB is a separate database, not a separate port.
DATABASE_URL=postgres://Marc@localhost:5432/pilates_dev
TEST_DATABASE_URL=postgres://Marc@localhost:5432/pilates_test

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CANCELLATION_WINDOW_HOURS_DEFAULT=2

# Comma-separated allowed origins for the admin/member web apps
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Serverless deploy (Vercel) ---
# Disable the in-process cron; an external scheduler hits POST /internal/sweep instead.
DISABLE_IN_PROCESS_CRON=false
SWEEP_SECRET=change-me-sweep
# CRON_SECRET is injected by Vercel Cron; set locally only for testing.
# DATABASE_SSL=true          # most hosted Postgres (Neon/Supabase) requires this
# DB_POOL_MAX=5
